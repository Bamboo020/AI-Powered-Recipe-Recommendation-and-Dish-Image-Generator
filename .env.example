# Copy to .env at repository root; loaded at API startup. Shell variables take precedence.
# All providers are disabled when their configuration is empty.
AI_DEVICE=cpu
EMBEDDING_MODEL=
# Suggested multilingual model: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Optional alternative encoder served by Ollama (takes priority over EMBEDDING_MODEL)
OLLAMA_EMBED_MODEL=
# Diffusion adapter uses SDXL Turbo parameters: 4 steps, guidance 0, 512px.
DIFFUSION_MODEL=
DIFFUSION_STEPS=4
DIFFUSION_GUIDANCE=0
DIFFUSION_UNLOAD_AFTER_GENERATION=1
# For standard SD 1.5 use 20 steps and guidance 7.5.
# Example after checking license/hardware: stabilityai/sdxl-turbo
CNN_CHECKPOINT=
CNN_LABELS_PATH=
